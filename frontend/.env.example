# Server-side configuration for the Next.js app (copy to .env.local for `npm run dev`).
# NONE of these are exposed to the browser: there are no NEXT_PUBLIC_* variables. The browser
# only calls this app's same-origin /api/* routes, which proxy to the backend on the server.

# FastAPI base URL as reached FROM THIS SERVER (no trailing slash). Required in production.
#   npm run dev:        http://localhost:8000 (the default outside production)
#   Docker Compose:     http://backend:8000   (set by docker-compose.yml)
#   Vercel:             https://<your-backend>.onrender.com
BACKEND_API_URL=http://localhost:8000

# Must equal the backend's API_ACCESS_KEY. Optional locally when the backend has no key.
BACKEND_API_ACCESS_KEY=

# --- Access gate -------------------------------------------------------------------------------
# Comma-separated label:code pairs, one per person or audience. Each code: >= 16 characters
# (openssl rand -base64 18). Remove a pair to revoke that code and its sessions.
# Production builds REFUSE all requests unless ACCESS_CODES is set or ALLOW_PUBLIC_ACCESS=true.
ACCESS_CODES=
# Signs session cookies; >= 32 characters (openssl rand -hex 32). Rotate to sign everyone out.
ACCESS_SESSION_SECRET=
# Session lifetime in hours (default 168 = 7 days).
# ACCESS_SESSION_TTL_HOURS=168
# Explicitly allow running a production build with no gate (not recommended for public hosts).
# ALLOW_PUBLIC_ACCESS=false

# Docker Compose variables (copy to .env next to docker-compose.yml). Never commit .env.
# Provider keys (OpenAI, Tavily, Weatherstack) go in backend/.env, not here.

# Shared secret between the frontend's server-side proxy and the backend
# (backend API_ACCESS_KEY = frontend BACKEND_API_ACCESS_KEY). At least 32 characters:
#   openssl rand -hex 32
BACKEND_API_ACCESS_KEY=

# --- Optional: access gate (leave ACCESS_CODES empty for an open local stack) -----------------
# Comma-separated label:code pairs, one per person. Codes: at least 16 characters, e.g.
#   openssl rand -base64 18
# ACCESS_CODES=reviewer-a:<code>,reviewer-b:<code>
# Signs session cookies; at least 32 characters (openssl rand -hex 32). Rotating it signs everyone out.
# ACCESS_SESSION_SECRET=
# ACCESS_SESSION_TTL_HOURS=168
